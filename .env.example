# Variables de Entorno — MenuQR Backend

# ─── App ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Número de proxies inversos por delante (nginx, balanceador...).
# Sin esto, el límite de peticiones ve la IP del proxy y agrupa a todos
# los clientes en el mismo cubo. Déjalo vacío si el API se expone directo.
TRUST_PROXY=

# Publica Swagger en producción. En desarrollo se sirve siempre.
ENABLE_API_DOCS=false

# ─── Seguridad ─────────────────────────────────────────────
# Orígenes autorizados a llamar al API, separados por comas.
# Admite el comodín `*.` para cubrir el subdominio de cada restaurante,
# que es ilimitado por diseño ({slug}.donpunto.com).
# En producción:
#   CORS_ORIGINS=https://donpunto.com,https://*.donpunto.com
# Si se deja vacío se derivan de FRONTEND_URL el dominio y sus subdominios,
# que en desarrollo cubre localhost:3001, app.localhost:3001 y {slug}.localhost:3001.
CORS_ORIGINS=

# ─── Base de Datos ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=menuqr_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_DIALECT=postgres

# ─── JWT ───────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_seguro
JWT_EXPIRES_IN=8h

# ─── Cloudinary ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ─── URLs ──────────────────────────────────────────────────
PUBLIC_BASE_URL=http://localhost:3000
QR_PUBLIC_BASE_URL=https://donpunto.com/q

# ─── Licencias ─────────────────────────────────────────────
# Días de aviso antes de vencimiento (HU_ADM_21)
LICENSE_ALERT_DAYS=7

# ─── Frontend ──────────────────────────────────────────────
# Base de las URLs a las que apuntan los códigos QR
FRONTEND_URL=http://localhost:3001
